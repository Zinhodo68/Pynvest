"""Dialogue d'achat avec champ de recherche unifié."""
import asyncio
from datetime import date, datetime
from nicegui import ui
from sqlalchemy import select

from database.db import get_session
from database.models import Position, Transaction, Portefeuille
from utils.formatters import format_money
from services.market_data import (
    get_current_price_with_currency,
    get_currency_rate,
    get_price_at_date_with_currency,
)
from services.search import unified_search
from pages.portefeuille_detail._cash_helpers import impact_cash, ajuster_cash


# Catégories disponibles pour la création manuelle
MANUAL_CATEGORIES = {
    'Action': 'Action',
    'ETF': 'ETF',
    'Fonds': 'Fonds / OPCVM',
    'SCPI': 'SCPI',
    'Obligation': 'Obligation',
    'Crypto': 'Crypto',
    'UC': 'Unité de Compte',
    'Projet': 'Projet (crowdfunding)',
    'Autre': 'Autre',
}


def open_buy_dialog(portefeuille_id, c, refresh):
    """Dialogue d'achat avec recherche unifiée."""

    state = {'selected': None}

    with get_session() as session:
        ptf = session.get(Portefeuille, portefeuille_id)
        is_av_per = ptf.type in ['Assurance-Vie', 'AV', 'PER', 'Assurance Vie']

        if is_av_per:
            fonds_euros_db = session.execute(
                select(Position).where(
                    Position.portefeuille_id == portefeuille_id,
                    Position.categorie.in_(['Fonds €', 'Fonds Euro']),
                )
            ).scalars().all()
            fonds_euros = {fe.id: {'nom': fe.nom, 'quantite': fe.quantite}
                           for fe in fonds_euros_db}
            cash_dispo = sum(fe['quantite'] for fe in fonds_euros.values())
            label_dispo = 'Fonds € disponibles'
        else:
            cash_pos = session.execute(
                select(Position).where(
                    Position.portefeuille_id == portefeuille_id,
                    Position.nom == 'Cash',
                )
            ).scalar_one_or_none()
            cash_dispo = (cash_pos.quantite if cash_pos else 0) or 0
            fonds_euros = {}
            label_dispo = 'Cash disponible'

    with ui.dialog() as dialog, ui.card().classes('p-6 gap-3').style(
            f'background-color: {c["card_bg"]}; '
            f'border: 1px solid {c["card_border"]}; '
            f'min-width: 700px; max-width: 800px;'
    ):
        ui.label('🛒 Acheter un titre').classes('text-xl font-bold').style(
            f'color: {c["text_primary"]}'
        )

        # Bandeau cash dispo
        with ui.row().classes('w-full items-center gap-2 px-3 py-2 rounded-lg').style(
                f'background-color: {"#10b981" if cash_dispo > 0 else "#ef4444"}20;'
        ):
            ui.icon('savings').classes('text-base').style(
                f'color: {"#10b981" if cash_dispo > 0 else "#ef4444"}'
            )
            ui.label(f'{label_dispo} : {format_money(cash_dispo)}').classes(
                'text-sm font-semibold'
            ).style(f'color: {"#10b981" if cash_dispo > 0 else "#ef4444"}')

        # ───────────────────────────────────────────────────────────────
        # CHAMP DE RECHERCHE UNIFIÉ
        # ───────────────────────────────────────────────────────────────
        ui.label('Rechercher un titre').classes('text-sm font-medium mt-2').style(
            f'color: {c["text_secondary"]}'
        )

        search_input = ui.input(
            placeholder='ex: Apple, AAPL, FR0010923375, Independance Expansion...',
        ).classes('w-full').props('clearable autofocus')

        results_container = ui.column().classes('w-full gap-1').style(
            'max-height: 350px; overflow-y: auto;'
        )

        form_container = ui.column().classes('w-full gap-3')
        form_container.set_visibility(False)

        search_task = {'task': None}
        last_query = {'value': ''}

        async def do_search(query: str):
            """Recherche unifiée avec debounce."""
            await asyncio.sleep(0.4)
            if query != last_query['value']:
                return  # Une nouvelle frappe a annulé celle-ci
            if not query or len(query) < 2:
                results_container.clear()
                return

            results_container.clear()
            with results_container:
                ui.label('⏳ Recherche en cours...').classes('text-sm py-2').style(
                    f'color: {c["text_secondary"]}'
                )

            try:
                grouped = await unified_search(query, limit_per_source=6)
            except Exception as e:
                results_container.clear()
                with results_container:
                    ui.label(f'⚠️ Erreur : {e}').classes('text-sm py-2').style(
                        f'color: #ef4444'
                    )
                return

            _render_grouped_results(grouped, query)

        def on_search_change(e):
            query = e.args if isinstance(e.args, str) else (e.value or '')
            query = (query or '').strip()
            last_query['value'] = query
            form_container.set_visibility(False)
            state['selected'] = None

            if search_task['task'] and not search_task['task'].done():
                search_task['task'].cancel()
            search_task['task'] = asyncio.create_task(do_search(query))

        search_input.on('update:model-value', on_search_change)

        # ───────────────────────────────────────────────────────────────
        # AFFICHAGE DES RÉSULTATS GROUPÉS
        # ───────────────────────────────────────────────────────────────
        def _render_grouped_results(grouped, query):
            results_container.clear()
            has_any = bool(grouped['db'] or grouped['yahoo'] or grouped['boursorama'])

            with results_container:
                # Indication ISIN détecté
                if grouped['is_isin']:
                    ui.label('🔎 ISIN détecté → recherche prioritaire Boursorama').classes(
                        'text-xs italic px-2 py-1'
                    ).style(f'color: {c["text_secondary"]}')

                # Groupe 1 : déjà dans tes portefeuilles
                if grouped['db']:
                    _render_group_header('📁 Déjà dans vos portefeuilles', len(grouped['db']))
                    for r in grouped['db']:
                        _render_result_row(r, source_label='db')

                # Groupe 2 : Yahoo
                if grouped['yahoo']:
                    _render_group_header('🌐 Yahoo Finance', len(grouped['yahoo']))
                    for r in grouped['yahoo']:
                        _render_result_row(r, source_label='yahoo')

                # Groupe 3 : Boursorama
                if grouped['boursorama']:
                    _render_group_header('📊 Boursorama (OPCVM/SICAV)', len(grouped['boursorama']))
                    for r in grouped['boursorama']:
                        _render_result_row(r, source_label='boursorama')

                # Groupe 4 : création manuelle (toujours affiché)
                _render_group_header('➕ Créer un nouveau support manuel', None)
                _render_create_manual_row(query)

                if not has_any:
                    ui.label('Aucun résultat trouvé dans Yahoo / Boursorama / vos portefeuilles.').classes(
                        'text-xs italic px-3 py-2'
                    ).style(f'color: {c["text_secondary"]}')

        def _render_group_header(label, count):
            count_str = f' ({count})' if count is not None else ''
            with ui.row().classes('w-full items-center mt-2 px-2'):
                ui.label(f'{label}{count_str}').classes(
                    'text-xs font-bold uppercase tracking-wider'
                ).style(f'color: {c["text_secondary"]}')

        def _render_result_row(r, source_label):
            type_colors = {
                'Action': '#3b82f6', 'ETF': '#10b981',
                'Fonds': '#8b5cf6', 'Crypto': '#f97316',
                'Indice': '#64748b', 'SCPI': '#f59e0b',
                'Autre': '#64748b',
            }
            type_color = type_colors.get(r.get('type', ''), '#64748b')

            with ui.row().classes(
                    'w-full items-center gap-3 p-2 rounded-lg cursor-pointer'
            ).style(f'background-color: {c["card_border"]}30;') \
                    .on('click', lambda res=r, src=source_label: select_ticker(res, src)):

                # Badge type
                ui.label(r.get('type', '?')).classes(
                    'text-xs font-bold px-2 py-1 rounded'
                ).style(
                    f'background-color: {type_color}30; color: {type_color}; '
                    f'min-width: 60px; text-align: center;'
                )

                # Nom + sous-info
                with ui.column().classes('gap-0').style('flex: 1; min-width: 0;'):
                    ui.label(r.get('name', '')).classes('text-sm font-medium').style(
                        f'color: {c["text_primary"]}; '
                        f'overflow: hidden; text-overflow: ellipsis; '
                        f'white-space: nowrap;'
                    )
                    sub_parts = []
                    if r.get('symbol'):
                        sub_parts.append(r['symbol'])
                    if r.get('isin') and r.get('isin') != r.get('symbol'):
                        sub_parts.append(r['isin'])
                    if r.get('exchange'):
                        sub_parts.append(r['exchange'])
                    sub = ' • '.join(sub_parts)
                    if sub:
                        ui.label(sub).classes('text-xs').style(
                            f'color: {c["text_secondary"]}'
                        )

                    # Si c'est une position déjà détenue : afficher dans quels portefeuilles
                    if source_label == 'db' and r.get('in_portfolios'):
                        for p_info in r['in_portfolios']:
                            ui.label(
                                f'   ↳ déjà dans {p_info["portefeuille"]} ({p_info["quantite"]:g} parts)'
                            ).classes('text-xs italic').style(f'color: #f59e0b')

                # Devise
                ui.label(r.get('currency', '')).classes('text-xs font-semibold') \
                    .style(
                    f'color: {c["text_secondary"]}; min-width: 40px; text-align: right;'
                )

        def _render_create_manual_row(query):
            with ui.row().classes(
                    'w-full items-center gap-3 p-2 rounded-lg cursor-pointer'
            ).style(f'background-color: #8b5cf620; border: 1px dashed #8b5cf6;') \
                    .on('click', lambda q=query: select_manual(q)):
                ui.icon('add_circle').classes('text-xl').style('color: #8b5cf6')
                with ui.column().classes('gap-0').style('flex: 1;'):
                    ui.label(f'Créer "{query or "..."}" comme support manuel').classes(
                        'text-sm font-medium'
                    ).style(f'color: {c["text_primary"]}')
                    ui.label('SCPI, crowdfunding, fonds non listé...').classes('text-xs') \
                        .style(f'color: {c["text_secondary"]}')

        # ───────────────────────────────────────────────────────────────
        # SÉLECTION D'UN RÉSULTAT
        # ───────────────────────────────────────────────────────────────
        def select_ticker(ticker_data, source_label):
            """L'utilisateur a cliqué sur un résultat de recherche."""
            results_container.clear()

            # Formater la valeur affichée dans le champ
            display = f'{ticker_data.get("name", "")}'
            if ticker_data.get('symbol'):
                display += f' ({ticker_data["symbol"]})'
            search_input.value = display

            # Source réelle (pas le label d'affichage)
            if source_label == 'db':
                # On hérite de la source originelle si possible
                if ticker_data.get('ticker'):
                    actual_source = 'yahoo'
                    symbol_or_url = ticker_data['ticker']
                elif ticker_data.get('isin'):
                    actual_source = 'boursorama'
                    symbol_or_url = ticker_data['isin']
                else:
                    actual_source = 'manual'
                    symbol_or_url = None
            elif source_label == 'yahoo':
                actual_source = 'yahoo'
                symbol_or_url = ticker_data.get('symbol')
            elif source_label == 'boursorama':
                actual_source = 'boursorama'
                symbol_or_url = ticker_data.get('url') or ticker_data.get('isin')
            else:
                actual_source = 'manual'
                symbol_or_url = None

            ticker_data['source'] = actual_source
            state['selected'] = ticker_data

            if actual_source == 'manual':
                # Pas de cours à récupérer, on affiche directement le formulaire
                _render_purchase_form(ticker_data)
                form_container.set_visibility(True)
                return

            ui.notify('Récupération du cours...', type='info')
            asyncio.create_task(_load_and_show(ticker_data, symbol_or_url, actual_source))

        async def _load_and_show(ticker_data, symbol_or_url, source):
            """Charge le cours actuel puis affiche le formulaire."""
            try:
                info = await asyncio.to_thread(
                    get_current_price_with_currency, symbol_or_url, source
                )
                ticker_data['current_price'] = info.get('price')
                if info.get('currency'):
                    ticker_data['currency'] = info['currency']
            except Exception as e:
                print(f'Erreur récupération cours : {e}')
                ticker_data['current_price'] = None

            _render_purchase_form(ticker_data)
            form_container.set_visibility(True)

        def select_manual(query):
            """L'utilisateur veut créer un nouveau support manuel."""
            ticker_data = {
                'name': query.strip() if query else 'Nouveau support',
                'symbol': query[:20] if query else '',
                'isin': None,
                'type': 'SCPI',  # défaut, modifiable dans le formulaire
                'exchange': 'Manuel',
                'currency': 'EUR',
                'source': 'manual',
                'current_price': None,
            }
            state['selected'] = ticker_data
            results_container.clear()
            search_input.value = f'➕ Création : {ticker_data["name"]}'
            _render_purchase_form(ticker_data, manual_creation=True)
            form_container.set_visibility(True)

        # ───────────────────────────────────────────────────────────────
        # FORMULAIRE D'ACHAT
        # ───────────────────────────────────────────────────────────────
        def _render_purchase_form(t, manual_creation=False):
            form_container.clear()
            updating = {'value': False}

            with form_container:
                # Card récap
                with ui.card().classes('w-full p-4 rounded-lg').style(
                        f'background-color: {c["card_border"]}30; '
                        f'border: 1px solid {c["card_border"]};'
                ):
                    with ui.row().classes('w-full items-center justify-between'):
                        with ui.column().classes('gap-0').style('flex: 1;'):
                            ui.label(t['name']).classes('text-base font-bold').style(
                                f'color: {c["text_primary"]}'
                            )
                            sub = (
                                f'{t.get("symbol", "")} • {t.get("type", "")} • '
                                f'{t.get("currency", "EUR")}'
                            )
                            ui.label(sub).classes('text-xs').style(
                                f'color: {c["text_secondary"]}'
                            )

                # Champs spécifiques au mode création manuelle
                manual_name_input = None
                manual_cat_input = None
                manual_code_input = None
                manual_devise_input = None

                if manual_creation:
                    ui.label('✍️ Création d\'un support manuel').classes('text-sm font-medium mt-2') \
                        .style(f'color: {c["text_secondary"]}')

                    with ui.row().classes('w-full gap-3'):
                        manual_name_input = ui.input(
                            'Nom du titre *', value=t['name']
                        ).classes('flex-1')
                        manual_cat_input = ui.select(
                            MANUAL_CATEGORIES, value=t.get('type', 'SCPI'),
                            label='Catégorie *',
                        ).classes('flex-1')

                    with ui.row().classes('w-full gap-3'):
                        manual_code_input = ui.input(
                            'Code / ISIN (optionnel)', value=t.get('isin') or ''
                        ).classes('flex-1') \
                            .props('placeholder="ex: FR0011053068"')
                        manual_devise_input = ui.select(
                            {'EUR': 'EUR €', 'USD': 'USD $', 'GBP': 'GBP £'},
                            value=t.get('currency', 'EUR'), label='Devise',
                        ).classes('w-32')

                # Date
                date_today_fr = date.today().strftime('%d/%m/%Y')
                with ui.input("Date d'achat", value=date_today_fr).classes('w-full') \
                        .props('mask="##/##/####" placeholder="JJ/MM/AAAA"') as date_input:
                    with ui.menu().props('no-parent-event') as menu:
                        date_picker = ui.date().bind_value(date_input).props(
                            'mask="DD/MM/YYYY"'
                        )
                        with date_picker:
                            with ui.row().classes('justify-end'):
                                ui.button('Fermer', on_click=menu.close).props('flat')
                    with date_input.add_slot('append'):
                        ui.icon('edit_calendar').on('click', menu.open).classes(
                            'cursor-pointer'
                        )

                # Prix
                prix_input = ui.number(
                    f'Prix unitaire ({t.get("currency", "EUR")}) *',
                    value=t.get('current_price') or 0,
                    format='%.4f', min=0,
                ).classes('w-full')

                price_info_label = ui.label('').classes('text-xs italic px-2').style(
                    f'color: {c["text_secondary"]}; min-height: 16px;'
                )

                price_state = {
                    'manually_modified': False,
                    'last_auto_value': t.get('current_price') or 0,
                }

                if t.get('current_price'):
                    price_info_label.text = (
                        f"💹 Cours actuel du marché : {t['current_price']:.4f} "
                        f"{t.get('currency', 'EUR')}"
                    )
                elif t.get('source') == 'manual':
                    price_info_label.text = "ℹ️ Saisie manuelle du prix"

                async def update_price_for_date():
                    if price_state['manually_modified']:
                        return
                    if t.get('source') == 'manual':
                        return

                    try:
                        target_date = datetime.strptime(
                            date_input.value, '%d/%m/%Y'
                        ).date()
                    except (ValueError, TypeError):
                        return

                    if target_date == date.today():
                        if t.get('current_price'):
                            updating['value'] = True
                            prix_input.value = t['current_price']
                            price_state['last_auto_value'] = t['current_price']
                            updating['value'] = False
                            price_info_label.text = (
                                f"💹 Cours actuel du marché : "
                                f"{t['current_price']:.4f} "
                                f"{t.get('currency', 'EUR')}"
                            )
                            update_montant_from_qte()
                        return

                    price_info_label.text = '⏳ Récupération du cours historique...'

                    source = t.get('source', 'yahoo')
                    if source == 'boursorama':
                        symbol_or_url = t.get('url') or t.get('isin')
                    else:
                        symbol_or_url = t.get('symbol') or t.get('ticker')

                    try:
                        info = await asyncio.to_thread(
                            get_price_at_date_with_currency,
                            symbol_or_url, source, target_date,
                        )

                        if info['price'] is not None:
                            updating['value'] = True
                            prix_input.value = round(info['price'], 4)
                            price_state['last_auto_value'] = info['price']
                            updating['value'] = False
                            price_info_label.text = (
                                f"💹 Cours du marché au {target_date.strftime('%d/%m/%Y')} : "
                                f"{info['price']:.4f} {info.get('currency', 'EUR')}"
                            )
                            update_montant_from_qte()
                        else:
                            price_info_label.text = (
                                "⚠️ Cours historique non disponible "
                                "(saisie manuelle requise)"
                            )
                    except Exception as e:
                        price_info_label.text = f"⚠️ Erreur : {e}"

                def on_price_change(e):
                    if updating['value']:
                        return
                    try:
                        new_value = float(prix_input.value or 0)
                        if abs(new_value - price_state['last_auto_value']) > 0.0001:
                            price_state['manually_modified'] = True
                            price_info_label.text = "✏️ Prix modifié manuellement"
                    except (TypeError, ValueError):
                        pass
                    update_montant_from_qte()

                def on_date_change(e):
                    price_state['manually_modified'] = False
                    asyncio.create_task(update_price_for_date())

                # Sélecteur Fonds € source (AV/PER)
                source_fonds_input = None
                if is_av_per:
                    if not fonds_euros:
                        ui.label('⚠️ Aucun Fonds € existant pour financer cet achat.').classes(
                            'text-red-500 text-sm font-bold mt-2'
                        )
                    else:
                        options = {
                            fe_id: f"{fe_data['nom']} ({format_money(fe_data['quantite'])})"
                            for fe_id, fe_data in fonds_euros.items()
                        }
                        source_fonds_input = ui.select(
                            options,
                            label='Fonds € source (pour le paiement) *',
                            value=list(options.keys())[0],
                        ).classes('w-full mt-2')

                frais_input = ui.number(
                    'Frais (€)', value=0, format='%.2f', min=0,
                ).classes('w-full')

                ui.label("Saisissez l'un OU l'autre").classes('text-xs italic mt-2') \
                    .style(f'color: {c["text_secondary"]}')

                with ui.row().classes('w-full gap-3'):
                    is_action = t.get('type') == 'Action'
                    qte_format = '%g' if is_action else '%.4f'
                    qte_step = 1 if is_action else 0.0001

                    quantite_input = ui.number(
                        '🔢 Quantité', value=0,
                        format=qte_format, min=0, step=qte_step,
                    ).classes('flex-1')

                    montant_input = ui.number(
                        f'💶 Montant ({t.get("currency", "EUR")})', value=0,
                        format='%.2f', min=0,
                    ).classes('flex-1')

                def update_montant_from_qte():
                    if updating['value']:
                        return
                    try:
                        q = float(quantite_input.value or 0)
                        p = float(prix_input.value or 0)
                        updating['value'] = True
                        montant_input.value = round(q * p, 2)
                        updating['value'] = False
                        update_summary()
                    except (TypeError, ValueError):
                        pass

                def update_qte_from_montant():
                    if updating['value']:
                        return
                    try:
                        m = float(montant_input.value or 0)
                        p = float(prix_input.value or 0)
                        if p > 0:
                            new_qte = m / p
                            new_qte = int(new_qte) if is_action else round(new_qte, 4)
                            updating['value'] = True
                            quantite_input.value = new_qte
                            updating['value'] = False
                        update_summary()
                    except (TypeError, ValueError):
                        pass

                quantite_input.on('update:model-value',
                                  lambda _: update_montant_from_qte())
                montant_input.on('update:model-value',
                                 lambda _: update_qte_from_montant())
                prix_input.on('update:model-value', on_price_change)
                frais_input.on('update:model-value', lambda _: update_summary())

                date_picker.on('update:model-value', on_date_change)
                date_input.on('blur', on_date_change)

                summary_label = ui.label().classes(
                    'text-sm font-medium px-3 py-2 rounded-lg whitespace-pre-line'
                ).style(
                    f'background-color: {c["card_border"]}; color: {c["text_primary"]};'
                )

                def update_summary():
                    try:
                        q = float(quantite_input.value or 0)
                        m = float(montant_input.value or 0)
                        p = float(prix_input.value or 0)
                        f = float(frais_input.value or 0)
                        cur = t.get('currency', 'EUR')

                        if cur != 'EUR':
                            summary_label.text = (
                                f'📦 {q:g} parts × {p:.4f} {cur} = {m:.2f} {cur}\n'
                                f'💸 + {f:.2f} € de frais\n'
                                f'⚠️ Conversion {cur}→EUR à la sauvegarde'
                            )
                        else:
                            total = m + f
                            warning = ''
                            if total > cash_dispo:
                                warning = (f'\n⚠️ Solde insuffisant '
                                           f'({format_money(cash_dispo)} dispo)')
                            summary_label.text = (
                                f'📦 {q:g} × {format_money(p, decimals=2)} '
                                f'= {format_money(m, decimals=2)}\n'
                                f'💸 + {format_money(f, decimals=2)} frais\n'
                                f'💰 Total : {format_money(total, decimals=2)}'
                                f'{warning}'
                            )
                    except (TypeError, ValueError):
                        summary_label.text = '💡 Saisissez quantité ou montant'

                update_summary()

                with ui.row().classes('w-full justify-end gap-2 mt-4'):
                    ui.button('Annuler', on_click=dialog.close).props('flat')

                    def save_achat():
                        # Si création manuelle : récupérer les valeurs des champs manuels
                        if manual_creation:
                            if not manual_name_input.value or not manual_name_input.value.strip():
                                ui.notify('Le nom est obligatoire', type='negative')
                                return
                            t['name'] = manual_name_input.value.strip()
                            t['type'] = manual_cat_input.value
                            t['isin'] = (manual_code_input.value or '').strip() or None
                            t['symbol'] = t['isin'] or t['name'][:20]
                            t['currency'] = manual_devise_input.value

                        # Bloquer la création de Fonds €
                        if t.get('type') in ('Fonds €', 'Fonds Euro'):
                            ui.notify(
                                "Un Fonds Euro ne peut pas être 'acheté'. "
                                "Il est alimenté par un versement.",
                                type='warning'
                            )
                            return

                        try:
                            date_val = datetime.strptime(
                                date_input.value, '%d/%m/%Y'
                            ).date()
                        except (ValueError, TypeError):
                            ui.notify('Date invalide', type='negative')
                            return
                        if not prix_input.value or prix_input.value <= 0:
                            ui.notify('Prix invalide', type='negative')
                            return
                        if not quantite_input.value or quantite_input.value <= 0:
                            ui.notify('Quantité invalide', type='negative')
                            return

                        q = float(quantite_input.value)
                        p_unit = float(prix_input.value)
                        if t.get('type') == 'Action' and q != int(q):
                            ui.notify('Quantité entière requise pour une action',
                                      type='negative')
                            return

                        frais = float(frais_input.value or 0)

                        prix_eur = p_unit
                        cur = t.get('currency', 'EUR')
                        if cur != 'EUR':
                            rate = get_currency_rate(cur, 'EUR')
                            if rate is None:
                                ui.notify(f'Conversion {cur}→EUR impossible',
                                          type='negative')
                                return
                            prix_eur = p_unit * rate

                        montant_titres_eur = q * prix_eur
                        total_eur = montant_titres_eur + frais

                        with get_session() as session:
                            fe_pos = None
                            if is_av_per:
                                if not source_fonds_input or not source_fonds_input.value:
                                    ui.notify("Veuillez sélectionner un Fonds € source",
                                              type='warning')
                                    return
                                fe_pos = session.get(Position, source_fonds_input.value)
                                cash_now = fe_pos.quantite or 0
                            else:
                                cash = session.execute(
                                    select(Position).where(
                                        Position.portefeuille_id == portefeuille_id,
                                        Position.nom == 'Cash',
                                    )
                                ).scalar_one_or_none()
                                cash_now = (cash.quantite if cash else 0) or 0

                            if cash_now < total_eur:
                                ui.notify(
                                    f'Solde insuffisant ({format_money(cash_now)} dispo)',
                                    type='warning'
                                )
